{
  "name": "luna-lang",
  "displayName": "Luna Language",
  "description": "Syntax highlighting for the Luna programming language (.luna files and ```luna fences).",
  "version": "0.0.1",
  "publisher": "luna-spec",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "luna",
        "aliases": [
          "Luna",
          "luna"
        ],
        "extensions": [
          ".luna"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "luna",
        "scopeName": "source.luna",
        "path": "./syntaxes/luna.tmLanguage.json"
      }
    ]
  }
}