{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "luna",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_token"
      }
    },
    "_token": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "attribute"
        },
        {
          "type": "SYMBOL",
          "name": "regex"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "command"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "punctuation"
        }
      ]
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "\\/\\/[^\\n]*"
          },
          {
            "type": "PATTERN",
            "value": "\\/\\*[^*]*\\*+([^/*][^*]*\\*+)*\\/"
          }
        ]
      }
    },
    "attribute": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "#\\[[^\\]]*\\]"
      }
    },
    "regex": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "~\"[^\"\\\\]*(?:\\\\[\\s\\S][^\"\\\\]*)*\"[imsxb]*"
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "\"\"\"([^\"\\\\]|\\\\[\\s\\S]|\"[^\"\\\\]|\"\"[^\"\\\\])*\"\"\""
          },
          {
            "type": "PATTERN",
            "value": "'''([^']|'[^']|''[^'])*'''"
          },
          {
            "type": "PATTERN",
            "value": "b?\"[^\"\\\\\\n]*(?:\\\\[^\\n][^\"\\\\\\n]*)*\""
          },
          {
            "type": "PATTERN",
            "value": "b?'[^'\\\\\\n]*(?:\\\\[^\\n][^'\\\\\\n]*)*'"
          }
        ]
      }
    },
    "command": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "`[^`\\\\\\n]*(?:\\\\[^\\n][^`\\\\\\n]*)*`"
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "(?:0|[1-9](?:_?[0-9])*)\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9]+)?|(?:0|[1-9](?:_?[0-9])*)[eE][+-]?[0-9]+|0x[0-9a-fA-F](?:_?[0-9a-fA-F])*|0b[01](?:_?[01])*|0o[0-7](?:_?[0-7])*|0|[1-9](?:_?[0-9])*"
      }
    },
    "identifier": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[A-Za-z_][A-Za-z0-9_]*!?"
      }
    },
    "punctuation": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\?\\?\\?=|\\?\\?\\?|\\?\\?=|\\?\\?|\\?->|\\?\\.|\\?|\\.\\.\\.|\\.\\.<|\\.\\.|\\.|\\x7c\\x7c|\\x7c|&&|&|->|-=|-|=>|==|=|!=|!|<=|<|>=|>|\\+=|\\+|\\*=|\\*|\\/=|\\/|%=|%|@@|@|\\(|\\)|\\{|\\}|\\[|\\]|,|;|:|~"
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}