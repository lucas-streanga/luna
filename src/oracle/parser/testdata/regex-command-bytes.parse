_ = ~"ab+c";
_ = ~"a${b}c";
_ = `ls -la`;
_ = `ls ${dir}`;
_ = b'\x00ff';
---
File 0..74
  Statement 0..12
    SimpleStmt 0..11
      Assignment 0..11
        AssignTarget 0..1
          WILDCARD 0..1 "_"
        ASSIGN 2..3 "="
        RegexLit 4..11
          REGEX 4..11 "~\"ab+c\""
    SEMICOLON 11..12 ";"
  Statement 13..27
    SimpleStmt 13..26
      Assignment 13..26
        AssignTarget 13..14
          WILDCARD 13..14 "_"
        ASSIGN 15..16 "="
        RegexLit 17..26
          REGEX_OPEN 17..19 "~\""
          REGEX_TEXT 19..20 "a"
          Splice 20..24
            INTERP_OPEN 20..22 "${"
            IDENT 22..23 "b"
            INTERP_CLOSE 23..24 "}"
          REGEX_TEXT 24..25 "c"
          REGEX_CLOSE 25..26 "\""
    SEMICOLON 26..27 ";"
  Statement 28..41
    SimpleStmt 28..40
      Assignment 28..40
        AssignTarget 28..29
          WILDCARD 28..29 "_"
        ASSIGN 30..31 "="
        CommandLit 32..40
          COMMAND 32..40 "`ls -la`"
    SEMICOLON 40..41 ";"
  Statement 42..58
    SimpleStmt 42..57
      Assignment 42..57
        AssignTarget 42..43
          WILDCARD 42..43 "_"
        ASSIGN 44..45 "="
        CommandLit 46..57
          CMD_OPEN 46..47 "`"
          CMD_TEXT 47..50 "ls "
          Splice 50..56
            INTERP_OPEN 50..52 "${"
            IDENT 52..55 "dir"
            INTERP_CLOSE 55..56 "}"
          CMD_CLOSE 56..57 "`"
    SEMICOLON 57..58 ";"
  Statement 59..73
    SimpleStmt 59..72
      Assignment 59..72
        AssignTarget 59..60
          WILDCARD 59..60 "_"
        ASSIGN 61..62 "="
        BYTES 63..72 "b'\\x00ff'"
    SEMICOLON 72..73 ";"
