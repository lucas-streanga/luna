_ = "${x}";
_ = "a${x}b";
_ = "${...xs}";
---
File 0..42
  Statement 0..11
    SimpleStmt 0..10
      Assignment 0..10
        AssignTarget 0..1
          WILDCARD 0..1 "_"
        ASSIGN 2..3 "="
        StringLit 4..10
          DQ_OPEN 4..5 "\""
          Splice 5..9
            INTERP_OPEN 5..7 "${"
            IDENT 7..8 "x"
            INTERP_CLOSE 8..9 "}"
          DQ_CLOSE 9..10 "\""
    SEMICOLON 10..11 ";"
  Statement 12..25
    SimpleStmt 12..24
      Assignment 12..24
        AssignTarget 12..13
          WILDCARD 12..13 "_"
        ASSIGN 14..15 "="
        StringLit 16..24
          DQ_OPEN 16..17 "\""
          DQ_TEXT 17..18 "a"
          Splice 18..22
            INTERP_OPEN 18..20 "${"
            IDENT 20..21 "x"
            INTERP_CLOSE 21..22 "}"
          DQ_TEXT 22..23 "b"
          DQ_CLOSE 23..24 "\""
    SEMICOLON 24..25 ";"
  Statement 26..41
    SimpleStmt 26..40
      Assignment 26..40
        AssignTarget 26..27
          WILDCARD 26..27 "_"
        ASSIGN 28..29 "="
        StringLit 30..40
          DQ_OPEN 30..31 "\""
          Splice 31..39
            INTERP_OPEN 31..33 "${"
            SPREAD 33..36 "..."
            IDENT 36..38 "xs"
            INTERP_CLOSE 38..39 "}"
          DQ_CLOSE 39..40 "\""
    SEMICOLON 40..41 ";"
