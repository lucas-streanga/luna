if else foreach in while break continue return match where
---
KW_IF 0..2 "if"
WHITESPACE 2..3 " "
KW_ELSE 3..7 "else"
WHITESPACE 7..8 " "
KW_FOREACH 8..15 "foreach"
WHITESPACE 15..16 " "
KW_IN 16..18 "in"
WHITESPACE 18..19 " "
KW_WHILE 19..24 "while"
WHITESPACE 24..25 " "
KW_BREAK 25..30 "break"
WHITESPACE 30..31 " "
KW_CONTINUE 31..39 "continue"
WHITESPACE 39..40 " "
KW_RETURN 40..46 "return"
WHITESPACE 46..47 " "
KW_MATCH 47..52 "match"
WHITESPACE 52..53 " "
KW_WHERE 53..58 "where"
WHITESPACE 58..59 "\n"
