+= + *= * /= / %= %
---
PLUS_ASSIGN 0..2 "+="
WHITESPACE 2..3 " "
PLUS 3..4 "+"
WHITESPACE 4..5 " "
STAR_ASSIGN 5..7 "*="
WHITESPACE 7..8 " "
STAR 8..9 "*"
WHITESPACE 9..10 " "
SLASH_ASSIGN 10..12 "/="
WHITESPACE 12..13 " "
SLASH 13..14 "/"
WHITESPACE 14..15 " "
PERCENT_ASSIGN 15..17 "%="
WHITESPACE 17..18 " "
PERCENT 18..19 "%"
WHITESPACE 19..20 "\n"
