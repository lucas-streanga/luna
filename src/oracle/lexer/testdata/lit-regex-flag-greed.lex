// `[imsxb]*` is greedy, so an adjacent flag letter is eaten: `~"a"bar` is not `~"a"` + `bar`.
let p = ~"a"bar;
let q = ~"a" bar;
let r = ~"a"imsxb;
---
LINE_COMMENT 0..94 "// `[imsxb]*` is greedy, so an adjacent flag letter is eaten: `~\"a\"bar` is not `~\"a\"` + `bar`."
WHITESPACE 94..95 "\n"
KW_LET 95..98 "let"
WHITESPACE 98..99 " "
IDENT 99..100 "p"
WHITESPACE 100..101 " "
ASSIGN 101..102 "="
WHITESPACE 102..103 " "
REGEX 103..108 "~\"a\"b"
IDENT 108..110 "ar"
SEMICOLON 110..111 ";"
WHITESPACE 111..112 "\n"
KW_LET 112..115 "let"
WHITESPACE 115..116 " "
IDENT 116..117 "q"
WHITESPACE 117..118 " "
ASSIGN 118..119 "="
WHITESPACE 119..120 " "
REGEX 120..124 "~\"a\""
WHITESPACE 124..125 " "
IDENT 125..128 "bar"
SEMICOLON 128..129 ";"
WHITESPACE 129..130 "\n"
KW_LET 130..133 "let"
WHITESPACE 133..134 " "
IDENT 134..135 "r"
WHITESPACE 135..136 " "
ASSIGN 136..137 "="
WHITESPACE 137..138 " "
REGEX 138..147 "~\"a\"imsxb"
SEMICOLON 147..148 ";"
WHITESPACE 148..149 "\n"
