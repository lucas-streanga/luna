( ) { } [ ] , ; :
---
LPAREN 0..1 "("
WHITESPACE 1..2 " "
RPAREN 2..3 ")"
WHITESPACE 3..4 " "
LBRACE 4..5 "{"
WHITESPACE 5..6 " "
RBRACE 6..7 "}"
WHITESPACE 7..8 " "
LBRACKET 8..9 "["
WHITESPACE 9..10 " "
RBRACKET 10..11 "]"
WHITESPACE 11..12 " "
COMMA 12..13 ","
WHITESPACE 13..14 " "
SEMICOLON 14..15 ";"
WHITESPACE 15..16 " "
COLON 16..17 ":"
WHITESPACE 17..18 "\n"
