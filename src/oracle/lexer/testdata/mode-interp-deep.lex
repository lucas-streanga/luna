let s = "a${ `ls ${b}` }c";
---
KW_LET 0..3 "let"
WHITESPACE 3..4 " "
IDENT 4..5 "s"
WHITESPACE 5..6 " "
ASSIGN 6..7 "="
WHITESPACE 7..8 " "
DQ_OPEN 8..9 "\""
DQ_TEXT 9..10 "a"
INTERP_OPEN 10..12 "${"
WHITESPACE 12..13 " "
CMD_OPEN 13..14 "`"
CMD_TEXT 14..17 "ls "
INTERP_OPEN 17..19 "${"
IDENT 19..20 "b"
INTERP_CLOSE 20..21 "}"
CMD_CLOSE 21..22 "`"
WHITESPACE 22..23 " "
INTERP_CLOSE 23..24 "}"
DQ_TEXT 24..25 "c"
DQ_CLOSE 25..26 "\""
SEMICOLON 26..27 ";"
WHITESPACE 27..28 "\n"
