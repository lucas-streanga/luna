yield x; yield (from); yield fromage;
---
KW_YIELD 0..5 "yield"
WHITESPACE 5..6 " "
IDENT 6..7 "x"
SEMICOLON 7..8 ";"
WHITESPACE 8..9 " "
KW_YIELD 9..14 "yield"
WHITESPACE 14..15 " "
LPAREN 15..16 "("
IDENT 16..20 "from"
RPAREN 20..21 ")"
SEMICOLON 21..22 ";"
WHITESPACE 22..23 " "
KW_YIELD 23..28 "yield"
WHITESPACE 28..29 " "
IDENT 29..36 "fromage"
SEMICOLON 36..37 ";"
WHITESPACE 37..38 "\n"
