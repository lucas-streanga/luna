import text.strings;
import { parse, split } from text.strings;
---
KW_IMPORT 0..6 "import"
WHITESPACE 6..7 " "
IDENT 7..11 "text"
DOT 11..12 "."
IDENT 12..19 "strings"
SEMICOLON 19..20 ";"
WHITESPACE 20..21 "\n"
KW_IMPORT 21..27 "import"
WHITESPACE 27..28 " "
LBRACE 28..29 "{"
WHITESPACE 29..30 " "
IDENT 30..35 "parse"
COMMA 35..36 ","
WHITESPACE 36..37 " "
IDENT 37..42 "split"
WHITESPACE 42..43 " "
RBRACE 43..44 "}"
WHITESPACE 44..45 " "
IDENT 45..49 "from"
WHITESPACE 49..50 " "
IDENT 50..54 "text"
DOT 54..55 "."
IDENT 55..62 "strings"
SEMICOLON 62..63 ";"
WHITESPACE 63..64 "\n"
