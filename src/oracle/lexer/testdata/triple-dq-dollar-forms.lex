let greeting = """
  Hello $name and ${other.x}!
  cost: \$5 for $n items
  """;
---
KW_LET 0..3 "let"
WHITESPACE 3..4 " "
IDENT 4..12 "greeting"
WHITESPACE 12..13 " "
ASSIGN 13..14 "="
WHITESPACE 14..15 " "
TRIPLE_DQ_OPEN 15..19 "\"\"\"\n"
MARGIN 19..21 "  "
DQ_TEXT 21..27 "Hello "
INTERP_IDENT 27..32 "$name"
DQ_TEXT 32..37 " and "
INTERP_OPEN 37..39 "${"
IDENT 39..44 "other"
DOT 44..45 "."
IDENT 45..46 "x"
INTERP_CLOSE 46..47 "}"
DQ_TEXT 47..48 "!"
DQ_TEXT 48..49 "\n"
MARGIN 49..51 "  "
DQ_TEXT 51..57 "cost: "
ESCAPE_PAIR 57..59 "\\$"
DQ_TEXT 59..65 "5 for "
INTERP_IDENT 65..67 "$n"
DQ_TEXT 67..73 " items"
TRIPLE_DQ_CLOSE 73..79 "\n  \"\"\""
SEMICOLON 79..80 ";"
WHITESPACE 80..81 "\n"
