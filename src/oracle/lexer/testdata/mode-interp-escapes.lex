let s = "a\n${x}\u{1F600}\$b";
---
KW_LET 0..3 "let"
WHITESPACE 3..4 " "
IDENT 4..5 "s"
WHITESPACE 5..6 " "
ASSIGN 6..7 "="
WHITESPACE 7..8 " "
DQ_OPEN 8..9 "\""
DQ_TEXT 9..10 "a"
ESCAPE_PAIR 10..12 "\\n"
INTERP_OPEN 12..14 "${"
IDENT 14..15 "x"
INTERP_CLOSE 15..16 "}"
ESCAPE_PAIR 16..25 "\\u{1F600}"
ESCAPE_PAIR 25..27 "\\$"
DQ_TEXT 27..28 "b"
DQ_CLOSE 28..29 "\""
SEMICOLON 29..30 ";"
WHITESPACE 30..31 "\n"
