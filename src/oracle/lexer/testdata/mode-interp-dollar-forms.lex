let s = "$name ${e} $ x";
---
KW_LET 0..3 "let"
WHITESPACE 3..4 " "
IDENT 4..5 "s"
WHITESPACE 5..6 " "
ASSIGN 6..7 "="
WHITESPACE 7..8 " "
DQ_OPEN 8..9 "\""
INTERP_IDENT 9..14 "$name"
DQ_TEXT 14..15 " "
INTERP_OPEN 15..17 "${"
IDENT 17..18 "e"
INTERP_CLOSE 18..19 "}"
DQ_TEXT 19..20 " "
DOLLAR_TEXT 20..21 "$"
DQ_TEXT 21..23 " x"
DQ_CLOSE 23..24 "\""
SEMICOLON 24..25 ";"
WHITESPACE 25..26 "\n"
