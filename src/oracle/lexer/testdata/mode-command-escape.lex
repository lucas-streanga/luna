let c = `a \` b \$ c ${x}`;
---
KW_LET 0..3 "let"
WHITESPACE 3..4 " "
IDENT 4..5 "c"
WHITESPACE 5..6 " "
ASSIGN 6..7 "="
WHITESPACE 7..8 " "
CMD_OPEN 8..9 "`"
CMD_TEXT 9..11 "a "
ESCAPE_PAIR 11..13 "\\`"
CMD_TEXT 13..16 " b "
ESCAPE_PAIR 16..18 "\\$"
CMD_TEXT 18..21 " c "
INTERP_OPEN 21..23 "${"
IDENT 23..24 "x"
INTERP_CLOSE 24..25 "}"
CMD_CLOSE 25..26 "`"
SEMICOLON 26..27 ";"
WHITESPACE 27..28 "\n"
