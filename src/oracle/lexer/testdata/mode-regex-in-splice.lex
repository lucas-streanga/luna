let s = "${ ~"x"i }";
let t = "${ `ls` }";
---
KW_LET 0..3 "let"
WHITESPACE 3..4 " "
IDENT 4..5 "s"
WHITESPACE 5..6 " "
ASSIGN 6..7 "="
WHITESPACE 7..8 " "
DQ_OPEN 8..9 "\""
INTERP_OPEN 9..11 "${"
WHITESPACE 11..12 " "
REGEX 12..17 "~\"x\"i"
WHITESPACE 17..18 " "
INTERP_CLOSE 18..19 "}"
DQ_CLOSE 19..20 "\""
SEMICOLON 20..21 ";"
WHITESPACE 21..22 "\n"
KW_LET 22..25 "let"
WHITESPACE 25..26 " "
IDENT 26..27 "t"
WHITESPACE 27..28 " "
ASSIGN 28..29 "="
WHITESPACE 29..30 " "
DQ_OPEN 30..31 "\""
INTERP_OPEN 31..33 "${"
WHITESPACE 33..34 " "
COMMAND 34..38 "`ls`"
WHITESPACE 38..39 " "
INTERP_CLOSE 39..40 "}"
DQ_CLOSE 40..41 "\""
SEMICOLON 41..42 ";"
WHITESPACE 42..43 "\n"
