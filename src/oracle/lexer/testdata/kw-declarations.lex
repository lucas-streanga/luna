var a; let b; const c; fn f; gen g; constraint k; proto p;
---
KW_VAR 0..3 "var"
WHITESPACE 3..4 " "
IDENT 4..5 "a"
SEMICOLON 5..6 ";"
WHITESPACE 6..7 " "
KW_LET 7..10 "let"
WHITESPACE 10..11 " "
IDENT 11..12 "b"
SEMICOLON 12..13 ";"
WHITESPACE 13..14 " "
KW_CONST 14..19 "const"
WHITESPACE 19..20 " "
IDENT 20..21 "c"
SEMICOLON 21..22 ";"
WHITESPACE 22..23 " "
KW_FN 23..25 "fn"
WHITESPACE 25..26 " "
IDENT 26..27 "f"
SEMICOLON 27..28 ";"
WHITESPACE 28..29 " "
KW_GEN 29..32 "gen"
WHITESPACE 32..33 " "
IDENT 33..34 "g"
SEMICOLON 34..35 ";"
WHITESPACE 35..36 " "
KW_CONSTRAINT 36..46 "constraint"
WHITESPACE 46..47 " "
IDENT 47..48 "k"
SEMICOLON 48..49 ";"
WHITESPACE 49..50 " "
KW_PROTO 50..55 "proto"
WHITESPACE 55..56 " "
IDENT 56..57 "p"
SEMICOLON 57..58 ";"
WHITESPACE 58..59 "\n"
