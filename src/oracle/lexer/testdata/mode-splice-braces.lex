let a = "${}";
let b = "${{}}";
let c = "${ {point} }";
---
KW_LET 0..3 "let"
WHITESPACE 3..4 " "
IDENT 4..5 "a"
WHITESPACE 5..6 " "
ASSIGN 6..7 "="
WHITESPACE 7..8 " "
DQ_OPEN 8..9 "\""
INTERP_OPEN 9..11 "${"
INTERP_CLOSE 11..12 "}"
DQ_CLOSE 12..13 "\""
SEMICOLON 13..14 ";"
WHITESPACE 14..15 "\n"
KW_LET 15..18 "let"
WHITESPACE 18..19 " "
IDENT 19..20 "b"
WHITESPACE 20..21 " "
ASSIGN 21..22 "="
WHITESPACE 22..23 " "
DQ_OPEN 23..24 "\""
INTERP_OPEN 24..26 "${"
LBRACE 26..27 "{"
RBRACE 27..28 "}"
INTERP_CLOSE 28..29 "}"
DQ_CLOSE 29..30 "\""
SEMICOLON 30..31 ";"
WHITESPACE 31..32 "\n"
KW_LET 32..35 "let"
WHITESPACE 35..36 " "
IDENT 36..37 "c"
WHITESPACE 37..38 " "
ASSIGN 38..39 "="
WHITESPACE 39..40 " "
DQ_OPEN 40..41 "\""
INTERP_OPEN 41..43 "${"
WHITESPACE 43..44 " "
LBRACE 44..45 "{"
IDENT 45..50 "point"
RBRACE 50..51 "}"
WHITESPACE 51..52 " "
INTERP_CLOSE 52..53 "}"
DQ_CLOSE 53..54 "\""
SEMICOLON 54..55 ";"
WHITESPACE 55..56 "\n"
