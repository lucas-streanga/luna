let s = "${x ?? "none"}";
---
KW_LET 0..3 "let"
WHITESPACE 3..4 " "
IDENT 4..5 "s"
WHITESPACE 5..6 " "
ASSIGN 6..7 "="
WHITESPACE 7..8 " "
DQ_OPEN 8..9 "\""
INTERP_OPEN 9..11 "${"
IDENT 11..12 "x"
WHITESPACE 12..13 " "
COALESCE 13..15 "??"
WHITESPACE 15..16 " "
STRING_DQ 16..22 "\"none\""
INTERP_CLOSE 22..23 "}"
DQ_CLOSE 23..24 "\""
SEMICOLON 24..25 ";"
WHITESPACE 25..26 "\n"
