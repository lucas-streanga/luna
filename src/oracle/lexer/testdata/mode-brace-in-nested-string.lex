// The `}` is inside a nested string, so it is content, not the splice's close.
let s = "${ "}" }";
let t = "${ "{" }";
---
LINE_COMMENT 0..79 "// The `}` is inside a nested string, so it is content, not the splice's close."
WHITESPACE 79..80 "\n"
KW_LET 80..83 "let"
WHITESPACE 83..84 " "
IDENT 84..85 "s"
WHITESPACE 85..86 " "
ASSIGN 86..87 "="
WHITESPACE 87..88 " "
DQ_OPEN 88..89 "\""
INTERP_OPEN 89..91 "${"
WHITESPACE 91..92 " "
STRING_DQ 92..95 "\"}\""
WHITESPACE 95..96 " "
INTERP_CLOSE 96..97 "}"
DQ_CLOSE 97..98 "\""
SEMICOLON 98..99 ";"
WHITESPACE 99..100 "\n"
KW_LET 100..103 "let"
WHITESPACE 103..104 " "
IDENT 104..105 "t"
WHITESPACE 105..106 " "
ASSIGN 106..107 "="
WHITESPACE 107..108 " "
DQ_OPEN 108..109 "\""
INTERP_OPEN 109..111 "${"
WHITESPACE 111..112 " "
STRING_DQ 112..115 "\"{\""
WHITESPACE 115..116 " "
INTERP_CLOSE 116..117 "}"
DQ_CLOSE 117..118 "\""
SEMICOLON 118..119 ";"
WHITESPACE 119..120 "\n"
