match! (x) { _ => 1 }
---
KW_MATCH_BANG 0..6 "match!"
WHITESPACE 6..7 " "
LPAREN 7..8 "("
IDENT 8..9 "x"
RPAREN 9..10 ")"
WHITESPACE 10..11 " "
LBRACE 11..12 "{"
WHITESPACE 12..13 " "
WILDCARD 13..14 "_"
WHITESPACE 14..15 " "
FAT_ARROW 15..17 "=>"
WHITESPACE 17..18 " "
INT_DEC 18..19 "1"
WHITESPACE 19..20 " "
RBRACE 20..21 "}"
WHITESPACE 21..22 "\n"
