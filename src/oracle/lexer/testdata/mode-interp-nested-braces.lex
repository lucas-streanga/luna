let s = "${ {point} }";
---
KW_LET 0..3 "let"
WHITESPACE 3..4 " "
IDENT 4..5 "s"
WHITESPACE 5..6 " "
ASSIGN 6..7 "="
WHITESPACE 7..8 " "
DQ_OPEN 8..9 "\""
INTERP_OPEN 9..11 "${"
WHITESPACE 11..12 " "
LBRACE 12..13 "{"
IDENT 13..18 "point"
RBRACE 18..19 "}"
WHITESPACE 19..20 " "
INTERP_CLOSE 20..21 "}"
DQ_CLOSE 21..22 "\""
SEMICOLON 22..23 ";"
WHITESPACE 23..24 "\n"
