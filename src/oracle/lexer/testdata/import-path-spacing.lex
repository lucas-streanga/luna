import yield.from;
import a . b ;
import a./*c*/b;
---
KW_IMPORT 0..6 "import"
WHITESPACE 6..7 " "
KW_YIELD 7..12 "yield"
DOT 12..13 "."
IDENT 13..17 "from"
SEMICOLON 17..18 ";"
WHITESPACE 18..19 "\n"
KW_IMPORT 19..25 "import"
WHITESPACE 25..26 " "
IDENT 26..27 "a"
WHITESPACE 27..28 " "
DOT 28..29 "."
WHITESPACE 29..30 " "
IDENT 30..31 "b"
WHITESPACE 31..32 " "
SEMICOLON 32..33 ";"
WHITESPACE 33..34 "\n"
KW_IMPORT 34..40 "import"
WHITESPACE 40..41 " "
IDENT 41..42 "a"
DOT 42..43 "."
BLOCK_COMMENT 43..48 "/*c*/"
IDENT 48..49 "b"
SEMICOLON 49..50 ";"
WHITESPACE 50..51 "\n"
