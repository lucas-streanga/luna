let s = "${ "${y}" }";
---
KW_LET 0..3 "let"
WHITESPACE 3..4 " "
IDENT 4..5 "s"
WHITESPACE 5..6 " "
ASSIGN 6..7 "="
WHITESPACE 7..8 " "
DQ_OPEN 8..9 "\""
INTERP_OPEN 9..11 "${"
WHITESPACE 11..12 " "
DQ_OPEN 12..13 "\""
INTERP_OPEN 13..15 "${"
IDENT 15..16 "y"
INTERP_CLOSE 16..17 "}"
DQ_CLOSE 17..18 "\""
WHITESPACE 18..19 " "
INTERP_CLOSE 19..20 "}"
DQ_CLOSE 20..21 "\""
SEMICOLON 21..22 ";"
WHITESPACE 22..23 "\n"
