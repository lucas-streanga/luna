a=b+c*d-e/f%g;x??y;z?.w;
---
IDENT 0..1 "a"
ASSIGN 1..2 "="
IDENT 2..3 "b"
PLUS 3..4 "+"
IDENT 4..5 "c"
STAR 5..6 "*"
IDENT 6..7 "d"
MINUS 7..8 "-"
IDENT 8..9 "e"
SLASH 9..10 "/"
IDENT 10..11 "f"
PERCENT 11..12 "%"
IDENT 12..13 "g"
SEMICOLON 13..14 ";"
IDENT 14..15 "x"
COALESCE 15..17 "??"
IDENT 17..18 "y"
SEMICOLON 18..19 ";"
IDENT 19..20 "z"
OPT_ACCESS 20..22 "?."
IDENT 22..23 "w"
SEMICOLON 23..24 ";"
WHITESPACE 24..25 "\n"
